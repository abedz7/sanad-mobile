# Base URL of sanad-server as reachable FROM THE DEVICE (no trailing slash).
# Default: the hosted API, so the app works without running the server locally.
# This value is public (Expo bundles EXPO_PUBLIC_* into the app); it is not a secret.
EXPO_PUBLIC_API_URL=https://sanad-server-production-8573.up.railway.app

# Running sanad-server yourself? Use one of these instead:
#   iOS Simulator / Android Emulator on this machine: http://localhost:4000 (Android: http://10.0.2.2:4000)
#   Physical phone with Expo Go: your computer's LAN IP, e.g. http://192.168.1.20:4000
